{
  "name": "sdw-he-vsce-cn-date-insert",
  "displayName": "SDW-HE 插入当前日期（含农历星期）",
  "description": "在光标处插入当天日期，格式：## 2026年9月18日 农历八月初八 周五",
  "version": "0.0.3",
  "publisher": "houengineer",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "日期",
    "农历",
    "星期",
    "date",
    "lunar",
    "insertCnDate"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/HouEngineer/sdw-he-vsce-cn-date-insert.git"
  },
  "icon": "images/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "cn-date-insert.insertCnDate",
        "title": "插入当前日期含农历星期 (insertCnDate)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.88.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "lunar-typescript": "^1.7.0"
  }
}
